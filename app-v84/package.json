{
  "name": "larios-rental-management",
  "version": "8.4.0",
  "private": true,
  "description": "Aplicacion web y nativa de gestion de Larios Rental",
  "scripts": {
    "test": "node ../tests/run-all.js",
    "serve": "python3 -m http.server 4173 --directory www",
    "sync": "npx cap sync",
    "android:add": "npx cap add android",
    "android:open": "npx cap open android",
    "ios:add": "npm run native:prepare && node scripts/create-ios.mjs",
    "ios:open": "npx cap open ios",
    "native:prepare": "node scripts/prepare-terminal.mjs && esbuild native/tap-to-pay.js --bundle --format=iife --target=es2020 --outfile=www/native-terminal.js",
    "ios:prepare": "python3 scripts/prepare-ios.py && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor-community/stripe-terminal": "8.3.0",
    "@capacitor-mlkit/text-recognition": "8.2.0",
    "@capacitor/android": "8.0.0",
    "@capacitor/app": "8.0.0",
    "@capacitor/camera": "8.0.0",
    "@capacitor/core": "8.0.0",
    "@capacitor/device": "8.0.0",
    "@capacitor/ios": "8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.0.0",
    "esbuild": "0.25.12"
  }
}
